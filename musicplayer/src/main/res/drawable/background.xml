<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Khi nhấn: xanh đậm hơn chút -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#9FD0E8"
                android:endColor="#EAF6FB"
                android:angle="45"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

    <!-- Trạng thái bình thường: pastel xanh rõ hơn -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#B3DBF2"
                android:endColor="#FFFFFF"
                android:angle="45"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

</selector>
