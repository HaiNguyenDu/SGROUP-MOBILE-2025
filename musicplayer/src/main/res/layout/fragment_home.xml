<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background"
        android:padding="@dimen/padding_normal"
        tools:context=".ui.HomeFragment">

        <!-- Title -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_title"
            android:textStyle="bold"
            android:textSize="@dimen/text_title"
            android:textColor="@color/primary_color"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Banner -->
        <ImageView
            android:id="@+id/iv_banner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/banner_height"
            android:layout_marginVertical="@dimen/padding_small"
            android:src="@drawable/homebanner"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_round"
            android:clipToOutline="true"
            app:layout_constraintTop_toBottomOf="@id/tv_title"/>

        <!-- Music title -->
        <TextView
            android:id="@+id/tv_music"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/list_music"
            android:layout_marginTop="@dimen/padding_normal"
            android:textStyle="bold"
            android:textSize="@dimen/text_title"
            android:textColor="@color/secondary_color"
            app:layout_constraintTop_toBottomOf="@id/iv_banner"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Music list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_music"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/tv_music"/>

        <!-- Album title -->
        <TextView
            android:id="@+id/tv_album"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/album"
            android:layout_marginTop="@dimen/padding_normal"
            android:textStyle="bold"
            android:textSize="@dimen/text_title"
            android:textColor="@color/secondary_color"
            app:layout_constraintTop_toBottomOf="@id/rv_music"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Album list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_album"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/tv_album"/>

        <!-- Artist title -->
        <TextView
            android:id="@+id/tv_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/artist"
            android:layout_marginTop="@dimen/padding_normal"
            android:textStyle="bold"
            android:textSize="@dimen/text_title"
            android:textColor="@color/secondary_color"
            app:layout_constraintTop_toBottomOf="@id/rv_album"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Artist list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/tv_artist"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
