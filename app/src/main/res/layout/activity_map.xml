<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.map.MapActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/light_pink"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/map_title"
            android:textColor="@color/white"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_search_map"
        android:layout_marginTop="@dimen/margin_medium"
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_x_height"
        app:cardCornerRadius="@dimen/radius_large"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <EditText
            android:id="@+id/et_seach_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autofillHints=""
            android:background="@color/light_pink"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="@dimen/padding_medium"
            android:hint="@string/search_map"
            android:inputType="text"
            android:paddingStart="@dimen/padding_medium"
            tools:ignore="RtlSymmetry" />
    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv_map"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_zero"
        android:padding="@dimen/padding_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cv_search_map" />
    <androidx.cardview.widget.CardView
        android:id="@+id/tag_origin"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/button_height_medium"
        android:layout_marginTop="@dimen/margin_medium"
        android:backgroundTint="@color/light_pink"
        app:cardCornerRadius="@dimen/radius_medium"
        app:layout_constraintStart_toStartOf="@id/tv_destination"
        app:layout_constraintBottom_toTopOf="@id/tv_origin">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="@dimen/padding_tiny"
            android:text="@string/tag_from"
            android:textSize="@dimen/text_small" />
    </androidx.cardview.widget.CardView>


    <TextView
        android:id="@+id/tv_origin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_height"
        android:layout_margin="@dimen/margin_small"
        android:maxLines="2"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:text="@string/place_name"
        android:textSize="@dimen/text_x_medium"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/tag_destination"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/tag_destination"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/button_height_medium"
        android:layout_marginTop="@dimen/margin_medium"
        android:backgroundTint="@color/light_pink"
        app:cardCornerRadius="@dimen/radius_medium"
        app:layout_constraintStart_toStartOf="@id/tv_destination"
        app:layout_constraintBottom_toTopOf="@id/tv_destination">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="@dimen/padding_tiny"
            android:text="@string/tag_destination"
            android:textSize="@dimen/text_small" />
    </androidx.cardview.widget.CardView>


    <TextView
        android:id="@+id/tv_destination"
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_height"
        android:layout_margin="@dimen/margin_small"
        android:maxLines="2"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:text="@string/place_name"
        android:textSize="@dimen/text_x_medium"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/btn_go" />

    <androidx.cardview.widget.CardView
        android:id="@+id/btn_go"
        android:layout_marginTop="@dimen/margin_medium"
        android:layout_width="@dimen/button_large"
        android:layout_height="@dimen/search_x_height"
        app:cardCornerRadius="@dimen/radius_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tv_go"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/light_pink"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:hint="@string/go"
            android:padding="@dimen/padding_small"/>
    </androidx.cardview.widget.CardView>
    <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66FFFFFF" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie_loading"
        android:layout_width="@dimen/card_width"
        android:layout_height="@dimen/size_zero"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cv_search_map"
        app:layout_constraintVertical_bias="1.0"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/loading" />
</androidx.constraintlayout.widget.ConstraintLayout>