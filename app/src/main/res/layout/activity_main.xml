<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/User_Background"
        android:layout_width="@dimen/login_background_width"
        android:layout_height= "@dimen/login_background_height"
        android:background="@color/black"
        android:scaleType="centerCrop"
        android:src="@drawable/user"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/Background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_background_bottom"
        android:background="@drawable/background_main"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/User_Background">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_sign_in"
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:text="@string/text_sign_in"
            android:textColor="#FFFFFF"
            android:textSize="17.92sp"
            android:textStyle="bold"
            app:backgroundTint="@android:color/transparent" />
    </LinearLayout>

    <TextView
        android:id="@+id/Title_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_title1"
        android:text="@string/text_title1"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_title1"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/Title_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_title2"
        android:textColor="#A4A4A4"
        android:textSize="@dimen/text_size_title2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Title_1" />

    <TextView
        android:id="@+id/Title_User"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="220dp"
        android:text="@string/title_user"
        android:textColor="#A4A4A4"
        android:textSize="@dimen/text_size_title_user"
        app:layout_constraintEnd_toEndOf="@id/Card_view"
        app:layout_constraintStart_toStartOf="@id/Card_view"
        app:layout_constraintTop_toBottomOf="@id/Title_2"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/Card_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        app:cardCornerRadius="12dp"
        app:cardUseCompatPadding="false"
        app:layout_constraintEnd_toEndOf="@+id/Title_1"
        app:layout_constraintStart_toStartOf="@+id/Title_1"
        app:layout_constraintTop_toBottomOf="@+id/Title_User">

        <EditText
            android:id="@+id/Box1_username"
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/gradient_box"
            android:hint="@string/hint_username"
            android:paddingStart="@dimen/padding_start_box1_username"
            android:textColorHint="#A4A4A4"
            android:textSize="@dimen/text_size_box1_username"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="17dp"
            android:src="@drawable/user_icon"/>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/Title_Password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="75dp"
        android:layout_marginEnd="220dp"
        android:text="@string/text_title_password"
        android:textColor="#A4A4A4"
        android:textSize="@dimen/text_size_title_password"
        app:layout_constraintEnd_toEndOf="@id/Card_view1"
        app:layout_constraintStart_toStartOf="@id/Card_view1"
        app:layout_constraintTop_toBottomOf="@id/Title_User" />

    <androidx.cardview.widget.CardView
        android:id="@+id/Card_view1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        app:cardCornerRadius="12dp"
        app:cardUseCompatPadding="false"
        app:layout_constraintEnd_toEndOf="@+id/Card_view"
        app:layout_constraintStart_toStartOf="@id/Card_view"
        app:layout_constraintTop_toBottomOf="@+id/Card_view">

        <EditText
            android:id="@+id/Box2_password"
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/gradient_box"
            android:hint="@string/text_title_password"
            android:inputType="textPassword"
            android:paddingStart="45dp"
            android:textColorHint="#A4A4A4"
            android:textSize="16dp" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="17dp"
            android:src="@drawable/pass" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/Title_ForgotPass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="190dp"
        android:layout_marginTop="10dp"
        android:text="@string/text_title_forgotpass"
        android:textColor="#A4A4A4"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/Card_view1" />

    <FrameLayout
        android:id="@+id/Card_view2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:background="@drawable/gradient_button"
        app:layout_constraintEnd_toEndOf="@+id/Card_view1"
        app:layout_constraintStart_toStartOf="@id/Card_view1"
        app:layout_constraintTop_toBottomOf="@+id/Card_view1">

    </FrameLayout>
    <FrameLayout
        android:id="@+id/Card_view3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/gradient_button"
        app:layout_constraintEnd_toEndOf="@+id/Card_view2"
        app:layout_constraintStart_toStartOf="@id/Card_view2"
        app:layout_constraintTop_toBottomOf="@+id/Card_view2">
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_sign_up"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:text="@string/text_sign_up"
        android:textColor="#FFFFFF"
        android:textSize="17.92sp"
        android:textStyle="bold"
        android:backgroundTint="@android:color/transparent"/>
</FrameLayout>

    <LinearLayout
        android:id="@+id/Continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="@id/Card_view3"
        app:layout_constraintStart_toStartOf="@id/Card_view3"
        app:layout_constraintTop_toBottomOf="@id/Card_view3">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="60dp"
            android:layout_weight="1"
            android:background="#A4A4A4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:text="@string/text_continue"
            android:textColor="#A4A4A4"
            android:textSize="11.25sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginEnd="60dp"
            android:layout_weight="1"
            android:background="#A4A4A4" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/icon_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/Card_view3"
        app:layout_constraintStart_toStartOf="@id/Card_view3"
        app:layout_constraintTop_toBottomOf="@id/Card_view3">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/list_google"
            android:layout_width="58.1dp"
            android:layout_height="44dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="12dp"
            app:cardUseCompatPadding="false">

            <ImageView
                android:id="@+id/icon_google"
                android:layout_width="16.34dp"
                android:layout_height="19.39dp"
                android:layout_gravity="center"
                android:layout_marginTop="1dp"
                android:src="@drawable/google" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/list_apple"
            android:layout_width="58.1dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="12dp"
            app:cardUseCompatPadding="false">

            <ImageView
                android:id="@+id/icon_apple"
                android:layout_width="16.34dp"
                android:layout_height="19.39dp"
                android:layout_gravity="center"
                android:layout_marginTop="1dp"
                android:src="@drawable/img" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/list_facebook"
            android:layout_width="58.1dp"
            android:layout_height="44dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="12dp"
            app:cardUseCompatPadding="false">

            <ImageView
                android:id="@+id/icon_facebook"
                android:layout_width="16.34dp"
                android:layout_height="19.39dp"
                android:layout_gravity="center"
                android:layout_marginTop="1dp"
                android:src="@drawable/facebook" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>