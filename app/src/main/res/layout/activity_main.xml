<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imagemain"
        android:layout_width="match_parent"
        android:layout_height="390dp"
        android:src="@drawable/user"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <LinearLayout
        android:id="@+id/login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="160dp"
        android:background="@drawable/background"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imagemain"
        app:layout_constraintVertical_bias="0.498" />

    <TextView
        android:id="@+id/titleto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="280dp"
        android:text="Welcome Back!"
        android:textColor="#EFEFEF"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/login"
        app:layout_constraintStart_toStartOf="@id/login"
        app:layout_constraintTop_toTopOf="parent"
        />

    <TextView
        android:id="@+id/titlenho"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="welcome back we missed you"
        android:textColor="#A4A4A4"
        android:textSize="15.5sp"
        android:textStyle="normal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleto"
        />

    <TextView
        android:id="@+id/usnamenho"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="63dp"
        android:layout_marginBottom="9dp"
        android:text="Username"
        android:textColor="#A4A4A4"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/edtUsername"
        app:layout_constraintStart_toStartOf="parent"
        />

    <EditText
        android:id="@+id/edtUsername"
        android:layout_width="280dp"
        android:layout_height="54dp"
        android:layout_margin="40dp"
        android:background="@drawable/gradian_box"
        android:drawableStart="@drawable/ic_user"
        android:drawablePadding="17dp"
        android:hint="Username"
        android:paddingStart="15dp"
        android:textSize="16sp"
        android:textColorHint="#A4A4A4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titlenho"
        />

    <EditText
        android:id="@+id/edtpassword"
        android:layout_width="280dp"
        android:layout_height="54dp"
        android:layout_margin="40dp"
        android:background="@drawable/gradian_box"
        android:drawableStart="@drawable/ic_login"
        android:drawableEnd="@drawable/eye"
        android:drawablePadding="17dp"
        android:hint="Password"
        android:textColorHint="#A4A4A4"
        android:paddingStart="12dp"
        android:paddingEnd="15dp"
        android:textSize="16sp"
        android:inputType="textPassword"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edtUsername"
        />

    <TextView
        android:id="@+id/password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="63dp"
        android:layout_marginBottom="9dp"
        android:text="Password"
        android:textColor="#A4A4A4"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/edtpassword"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/forgotpass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="63dp"
        android:text="Forgot Password?"
        android:textColor="#A4A4A4"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edtpassword"
        />

    <FrameLayout
        android:id="@+id/button_container"
        android:layout_width="280dp"
        android:layout_height="54dp"
        android:layout_margin="50dp"
        android:background="@drawable/gradian_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edtpassword">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/signin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Sign in"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            app:strokeWidth="0dp" />

    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12sp"
        android:drawableStart="@drawable/gachtrang"
        android:drawableEnd="@drawable/gachtrang"
        android:drawablePadding="10dp"
        android:text="Or continue with"
        android:textColor="#A4A4A4"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_container"
        />

    <LinearLayout
        android:id="@+id/buttongroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_google"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="#2C2C2E"
            app:cardCornerRadius="12dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="15dp"
                android:src="@drawable/img" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardapple"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="#2C2C2E"
            app:cardCornerRadius="12dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="15dp"
                android:src="@drawable/img_1" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardfacebook"
            android:layout_width="70dp"
            android:layout_height="60dp"
            app:cardBackgroundColor="#2C2C2E"
            app:cardCornerRadius="12dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="15dp"
                android:src="@drawable/img_4" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>