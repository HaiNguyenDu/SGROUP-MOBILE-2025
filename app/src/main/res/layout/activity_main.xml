<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">
    <ImageView
        android:id="@+id/User_Background"
        android:layout_width="432dp"
        android:layout_height="393dp"
        android:src="@drawable/user"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/black"
        android:scaleType="centerCrop" />
    <LinearLayout
        android:id="@+id/Background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/User_Background"
        android:background="@drawable/background"
        android:layout_marginBottom="120dp"
        android:gravity="center">
    </LinearLayout>
        <TextView
            android:id="@+id/Title_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome Back!"
            android:textSize="40.33dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="270dp"
            />
    <TextView
        android:id="@+id/Title_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="welcome back we missed you"
        android:textColor="#A4A4A4"
        android:textSize="14.33dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Title_1"
        />
    <TextView
        android:id="@+id/Title_User"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Username"
        android:textColor="#A4A4A4"
        android:textSize="14.33dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/Title_2"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="220dp"
        />
    <androidx.cardview.widget.CardView
        android:id="@+id/Card_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardUseCompatPadding="false"
        app:layout_constraintStart_toStartOf="@+id/Title_1"
        app:layout_constraintEnd_toEndOf="@+id/Title_1"
        app:layout_constraintTop_toBottomOf="@+id/Title_User"
        android:layout_marginTop="15dp">
        <EditText
            android:id="@+id/Box1_username"
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:textSize="16dp"
            android:hint="Username"
            android:layout_gravity="center_vertical"
            android:background="@drawable/gradient_box"
            android:textColorHint="#A4A4A4"
            android:paddingStart="40dp"
            />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/user_icon"
            android:layout_marginTop="17dp"
            android:layout_marginStart="10dp"
        />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/Title_Password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Password"
        android:textColor="#A4A4A4"
        android:textSize="14.33dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/Title_User"
        android:layout_marginTop="75dp"
        android:layout_marginEnd="220dp"
        />
    <androidx.cardview.widget.CardView
        android:id="@+id/Card_view1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardUseCompatPadding="false"
        app:layout_constraintStart_toStartOf="@id/Card_view"
        app:layout_constraintEnd_toEndOf="@+id/Card_view"
        app:layout_constraintTop_toBottomOf="@+id/Card_view"
        android:layout_marginTop="35dp">
        <EditText
            android:id="@+id/Box2_password"
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:textSize="16dp"
            android:hint="Password"
            android:layout_gravity="center_vertical"
            android:background="@drawable/gradient_box"
            android:textColorHint="#A4A4A4"
            android:paddingStart="45dp"
            android:inputType="textPassword"
            />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/pass"
            android:layout_marginTop="17dp"
            android:layout_marginStart="10dp"
            />

    </androidx.cardview.widget.CardView>
    <TextView
        android:id="@+id/Title_ForgotPass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Forgot Password?"
        android:textColor="#A4A4A4"
        android:textSize="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/Card_view1"
        android:layout_marginTop="10dp"
        android:layout_marginStart="190dp"
        />


    <androidx.cardview.widget.CardView
        android:id="@+id/Card_view2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:cardUseCompatPadding="false"
        app:layout_constraintStart_toStartOf="@id/Card_view1"
        app:layout_constraintEnd_toEndOf="@+id/Card_view1"
        app:layout_constraintTop_toBottomOf="@+id/Card_view1"
        android:layout_marginTop="35dp">
        <TextView
            android:layout_width="300dp"
            android:layout_height="50dp"
            app:layout_constraintStart_toStartOf="@id/Card_view1"
            app:layout_constraintEnd_toEndOf="@id/Card_view1"
            app:layout_constraintTop_toBottomOf="@id/Card_view1"
            android:text="Sign in"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="17.92dp"
            android:textColor="#FFFFFF"
            android:background="@drawable/gradient_button"
            />
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:id="@+id/Continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="@id/Card_view2"
        app:layout_constraintEnd_toEndOf="@id/Card_view2"
        app:layout_constraintTop_toBottomOf="@id/Card_view2"
        android:layout_marginTop="15dp">
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#A4A4A4"
            android:layout_marginStart="60dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Or continue with"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:textColor="#A4A4A4"
            android:textSize="11.25dp"
            />
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#A4A4A4"
            android:layout_marginEnd="60dp"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/icon_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        app:layout_constraintStart_toStartOf="@id/Card_view2"
        app:layout_constraintEnd_toEndOf="@id/Card_view2"
        app:layout_constraintTop_toBottomOf="@id/Card_view2"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        >
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/list_google"
            android:layout_width="58.1dp"
            android:layout_height="44dp"
            app:cardUseCompatPadding="false"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@android:color/transparent">
            <ImageView
                android:id="@+id/icon_google"
                android:layout_width="16.34dp"
                android:layout_height="19.39dp"
                android:layout_gravity="center"
                android:src="@drawable/google"
                android:layout_marginTop="1dp"
                />
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/list_apple"
            android:layout_width="58.1dp"
            android:layout_height="44dp"
            app:cardUseCompatPadding="false"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@android:color/transparent">
            <ImageView
                android:id="@+id/icon_apple"
                android:layout_width="16.34dp"
                android:layout_height="19.39dp"
                android:layout_gravity="center"
                android:src="@drawable/img"
                android:layout_marginTop="1dp"
                />
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/list_facebook"
            android:layout_width="58.1dp"
            android:layout_height="44dp"
            app:cardUseCompatPadding="false"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@android:color/transparent">
            <ImageView
                android:id="@+id/icon_facebook"
                android:layout_width="16.34dp"
                android:layout_height="19.39dp"
                android:layout_gravity="center"
                android:src="@drawable/facebook"
                android:layout_marginTop="1dp"
                />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>