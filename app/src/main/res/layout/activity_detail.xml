<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".detail.DetailActivity">
    <ImageView
        android:id="@+id/iv_main_background"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/gradient_detail_background"/>
    <ImageView
        android:id="@+id/iv_round_background"
        android:layout_width="595dp"
        android:layout_height="595dp"
        android:layout_marginTop="-385dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/bg_round_black"/>
    <ImageView
        android:id="@+id/iv_product"
        android:layout_width="315dp"
        android:layout_height="229dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/detail_preview"
        android:scaleType="centerInside"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="28dp" />
    <ImageView
        android:id="@+id/iv_heart"
        android:layout_width="29dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_heart_white"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_detail_back"
        android:layout_width="12dp"
        android:layout_height="24dp"
        android:background="@drawable/ic_detail_back"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/product_list"
        android:layout_width="410dp"
        android:layout_height="60dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_main_background"
        android:layout_marginStart="20dp"/>

    <TextView
        android:id="@+id/tv_detail_brand"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:text="Nike"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="@+id/product_list"
        app:layout_constraintTop_toBottomOf="@id/product_list" />

    <TextView
        android:id="@+id/tv_detail_cost"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginEnd="20dp"
        android:text="$115"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_detail_brand" />

    <ImageView
        android:id="@+id/iv_detail_minus"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_minus"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintTop_toBottomOf="@id/tv_detail_cost"
        app:layout_constraintEnd_toStartOf="@id/iv_detail_plus"
        app:layout_constraintStart_toStartOf="@id/tv_detail_cost"/>

    <ImageView
        android:id="@+id/iv_detail_plus"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_plus"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tv_detail_cost"
        app:layout_constraintEnd_toEndOf="@id/tv_detail_cost"
        app:layout_constraintStart_toEndOf="@id/iv_detail_minus"/>

    <TextView
        android:id="@+id/tv_detail_des_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Air Force 1 Shadow Beige Pale Ivory"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="@id/tv_detail_brand"
        app:layout_constraintTop_toBottomOf="@id/tv_detail_brand"/>
    <View
        android:id="@+id/v_detail_line1"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#A4A4A4"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="@id/tv_detail_des_brand"
        app:layout_constraintTop_toBottomOf="@id/tv_detail_des_brand"
        app:layout_constraintEnd_toEndOf="@id/tv_detail_cost"/>

    <TextView
        android:id="@+id/tv_detail_des_long"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/detail_des_long"
        android:textSize="16sp"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="@id/v_detail_line1"
        app:layout_constraintStart_toStartOf="@id/v_detail_line1"
        app:layout_constraintTop_toBottomOf="@id/v_detail_line1" />
    <TextView
        android:id="@+id/tv_detail_read_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/detail_read_more"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="@+id/tv_detail_des_long"
        app:layout_constraintTop_toBottomOf="@id/tv_detail_des_long"/>
    <View
        android:id="@+id/v_detail_line2"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#A4A4A4"
        app:layout_constraintStart_toStartOf="@id/v_detail_line1"
        app:layout_constraintTop_toBottomOf="@id/tv_detail_read_more"
        app:layout_constraintEnd_toEndOf="@id/v_detail_line1"/>

    <TextView
        android:id="@+id/tv_size"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        app:layout_constraintStart_toStartOf="@+id/v_detail_line2"
        app:layout_constraintTop_toBottomOf="@id/v_detail_line2"
        android:text="Size"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="17sp"
        android:layout_marginTop="10dp"/>
    <TextView
        android:id="@+id/tv_us"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:text="US"
        android:textSize="15sp"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="@+id/v_detail_line2"
        app:layout_constraintTop_toBottomOf="@id/v_detail_line2"
        android:layout_marginTop="10dp" />
    <TextView
        android:id="@+id/tv_uk"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:text="UK"
        android:textSize="15sp"
        android:textColor="@color/black"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toStartOf="@id/tv_us"
        app:layout_constraintTop_toBottomOf="@id/v_detail_line2"/>
    <TextView
        android:id="@+id/tv_eur"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:text="EUR"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toStartOf="@id/tv_uk"
        app:layout_constraintTop_toBottomOf="@id/v_detail_line2"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/product_size"
        android:layout_width="410dp"
        android:layout_height="60dp"
        app:layout_constraintStart_toStartOf="@id/v_detail_line2"
        app:layout_constraintTop_toBottomOf="@id/v_detail_line2"
        android:layout_marginTop="40dp">
    </androidx.recyclerview.widget.RecyclerView>
    <View
        android:id="@+id/btn_add_to_cart"
        android:layout_width="335dp"
        android:layout_height="50dp"
        android:background="@drawable/btn_add_to_cart"
        app:layout_constraintTop_toBottomOf="@+id/product_size"
        app:layout_constraintStart_toStartOf="@id/v_detail_line2"
        app:layout_constraintEnd_toEndOf="@id/v_detail_line2"/>
    <TextView
        android:id="@+id/tv_add_to_cart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ADD TO CART"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/btn_add_to_cart"
        app:layout_constraintEnd_toEndOf="@id/btn_add_to_cart"
        app:layout_constraintTop_toTopOf="@id/btn_add_to_cart"
        app:layout_constraintBottom_toBottomOf="@id/btn_add_to_cart"/>
</androidx.constraintlayout.widget.ConstraintLayout>