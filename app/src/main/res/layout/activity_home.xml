<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".home.HomeActivity">
    <EditText
        android:id="@+id/et_Search"
        android:layout_width="288dp"
        android:layout_height="40dp"
        android:shadowColor="#C0C0C0"
        android:hint="@string/search_product"
        android:background="@drawable/bg_search"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="10dp"
        android:layout_marginEnd="20dp"
        android:inputType="text"
        android:textSize="16sp"
        android:textColor="#8B8B8B"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <View
        android:id="@+id/v_ic_list"
        android:layout_width="23dp"
        android:layout_height="14dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/ic_list"
        app:layout_constraintEnd_toStartOf="@+id/et_Search"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/tv_Sneakers"
        android:layout_width="147dp"
        android:layout_height="37dp"
        android:text="@string/main_sneaker"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toStartOf="@+id/v_ic_list"
        app:layout_constraintTop_toBottomOf="@+id/v_ic_list"/>
    <TextView
        android:id="@+id/tv_found"
        android:layout_width="wrap_content"
        android:layout_height="21dp"
        android:text="@string/product_found"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintStart_toStartOf="@+id/tv_Sneakers"
        app:layout_constraintTop_toBottomOf="@+id/tv_Sneakers"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycle_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"
        app:layout_constraintTop_toBottomOf="@+id/tv_found"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_product"/>
</androidx.constraintlayout.widget.ConstraintLayout>
