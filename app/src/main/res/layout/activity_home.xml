<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    
    <LinearLayout
        android:id="@+id/layoutSearch"
        android:layout_width="@dimen/dp_0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/search"
        android:padding="@dimen/dp_8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="@dimen/dp_29dp"
        >

        <ImageView
            android:layout_width="@dimen/dp_24dp"
            android:layout_height="@dimen/dp_24dp"
            android:contentDescription="@string/sign_up"
            android:src="@drawable/outline_feature_search_24" />

        <EditText
            android:id="@+id/edtSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/edt_search"
            android:autofillHints="search"
            android:background="@null"
            android:layout_marginStart="@dimen/dp_8dp"
            android:padding="@dimen/dp_4dp"
            android:inputType="text"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="@dimen/dp_16dp"
        app:layout_constraintTop_toBottomOf="@id/layoutSearch"
        app:layout_constraintStart_toStartOf="parent"
        >

        <TextView
            android:id="@+id/tv_Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tv_sneakers"
            android:textSize="@dimen/sp_30sp"
            android:fontFamily="@font/font2_montserrat"
            android:textColor="@color/black"/>

        <TextView
            android:id="@+id/tv_Count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tv_count"
            android:textSize="@dimen/sp_16sp"
            android:textColor="@color/black"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewProducts"
        android:layout_width="@dimen/dp_0dp"
        android:layout_height="@dimen/dp_0dp"
        android:padding="@dimen/dp_8dp"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
