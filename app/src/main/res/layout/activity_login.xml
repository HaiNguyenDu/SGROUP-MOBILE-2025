<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/user_bg"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:scaleType="centerCrop"
        android:src="@drawable/userbackground"
        app:layout_constraintTop_toTopOf="parent"
        ></ImageView>

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="56dp"
        android:src="@drawable/background"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="0dp"></ImageView>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="112dp"
        android:src="@drawable/objectbackgrounds"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="-80dp"
        ></ImageView>

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome Back!"
        android:textColor="@color/white"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/user_bg"
        android:layout_marginTop="-30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        ></TextView>
    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="welcome back we missed you"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

    </TextView>
    <TextView
        android:id="@+id/tag_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Username"
        app:layout_constraintStart_toStartOf="@id/title"
        app:layout_constraintTop_toBottomOf="@id/message"
        android:layout_marginTop="15dp"
        ></TextView>
    <androidx.cardview.widget.CardView
        android:id="@+id/card_username"
        android:background="@color/white"
        android:layout_width="280dp"
        android:layout_height="55dp"
        app:layout_constraintTop_toBottomOf="@id/tag_user"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardBackgroundColor="#17ffffff"

        >
        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Username"
            android:drawableStart="@drawable/ic_user"
            android:layout_marginLeft="10dp"
            android:drawablePadding="10dp"
            android:textColor="@color/white"
            android:background="@null"
            >
        </com.google.android.material.textfield.TextInputEditText>


    </androidx.cardview.widget.CardView>
    <TextView
        android:id="@+id/tag_pw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Password"
        app:layout_constraintStart_toStartOf="@id/title"
        app:layout_constraintTop_toBottomOf="@id/card_username"
        android:layout_marginTop="15dp"
        ></TextView>
    <androidx.cardview.widget.CardView
        android:id="@+id/card_pw"
        android:background="@color/white"
        android:layout_width="280dp"
        android:layout_height="55dp"
        app:layout_constraintTop_toBottomOf="@id/tag_pw"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardBackgroundColor="#17ffffff"

        >
        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="******"
            android:inputType="textPassword"
            android:drawableStart="@drawable/ic_key"
            android:layout_marginLeft="10dp"
            android:drawablePadding="10dp"
            android:drawableEnd="@drawable/ic_hint"
            android:layout_marginEnd="10dp"
            android:background="@null"
            >
        </com.google.android.material.textfield.TextInputEditText>


    </androidx.cardview.widget.CardView>
    <TextView
        android:id="@+id/tag_forgot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Forgot Password?"
        app:layout_constraintTop_toBottomOf="@id/card_pw"
        app:layout_constraintEnd_toEndOf="@id/card_pw"
        android:layout_marginTop="10dp"

        ></TextView>
    <androidx.cardview.widget.CardView
        android:id="@+id/card_submit"
        android:layout_width="280dp"
        android:layout_height="55dp"
        app:layout_constraintTop_toBottomOf="@id/tag_forgot"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardBackgroundColor="#9C3FE2"

        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:text="Sign in"
            android:gravity="center">

        </TextView>


    </androidx.cardview.widget.CardView>
    <TextView
        android:id="@+id/continue_with"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Or continue with"
        app:layout_constraintTop_toBottomOf="@id/card_submit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="10dp"
        >

    </TextView>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_google"
        app:layout_constraintTop_toBottomOf="@+id/continue_with"
        app:layout_constraintEnd_toStartOf="@id/icon_fb"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="10dp"
        ></TextView>
    <TextView
        android:id="@+id/icon_fb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_apple"
        app:layout_constraintTop_toBottomOf="@+id/continue_with"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"

        ></TextView>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_fb"
        app:layout_constraintTop_toBottomOf="@+id/continue_with"
        app:layout_constraintStart_toEndOf="@id/icon_fb"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        ></TextView>

</androidx.constraintlayout.widget.ConstraintLayout>