<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/User_Background_Register"
        android:layout_width="@dimen/login_background_width"
        android:layout_height="@dimen/login_background_height"
        android:src="@drawable/background_icon_register"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/black"/>
    <ImageView
            android:id="@+id/User_Register_Background"
            android:layout_width="@dimen/register_background_width"
            android:layout_height="@dimen/register_background_height"
            android:src="@drawable/user_register"
            android:layout_marginStart="147dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />
    <ImageButton
        android:id="@+id/button_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="16dp"
        android:background="@android:color/transparent"
        app:srcCompat="@drawable/ic_back"
        android:elevation="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:id="@+id/Background_Register"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_background_bottom"
        android:background="@drawable/background_main"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/User_Background_Register"/>
    <TextView
        android:id="@+id/Title_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_title1"
        android:text="@string/text_title_register_1"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_title1"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/Title_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_title_register_2"
        android:textColor="#A4A4A4"
        android:textSize="@dimen/text_size_title2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Title_1" />

    <TextView
        android:id="@+id/Title_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="220dp"
        android:text="@string/text_title_email_register"
        android:textColor="#A4A4A4"
        android:textSize="@dimen/text_size_box"
        app:layout_constraintEnd_toEndOf="@id/Card_view"
        app:layout_constraintStart_toStartOf="@id/Card_view"
        app:layout_constraintTop_toBottomOf="@id/Title_2"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/Card_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        app:cardCornerRadius="12dp"
        app:cardUseCompatPadding="false"
        app:layout_constraintEnd_toEndOf="@+id/Title_1"
        app:layout_constraintStart_toStartOf="@+id/Title_1"
        app:layout_constraintTop_toBottomOf="@+id/Title_email">

        <EditText
            android:id="@+id/Box1_email_address"
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/gradient_box"
            android:hint="@string/hint_email_address"
            android:paddingStart="@dimen/padding_start_box1_username"
            android:textColorHint="#A4A4A4"
            android:textSize="@dimen/text_size_box"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="17dp"
            android:src="@drawable/ic_mail"/>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/Title_Name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="220dp"
        android:text="@string/text_title_name"
        android:textColor="#A4A4A4"
        android:textSize="@dimen/text_size_box"
        app:layout_constraintEnd_toEndOf="@id/Card_view1"
        app:layout_constraintStart_toStartOf="@id/Card_view1"
        app:layout_constraintTop_toBottomOf="@id/Card_view" />

    <androidx.cardview.widget.CardView
        android:id="@+id/Card_view1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        app:cardCornerRadius="12dp"
        app:cardUseCompatPadding="false"
        app:layout_constraintEnd_toEndOf="@+id/Card_view"
        app:layout_constraintStart_toStartOf="@id/Card_view"
        app:layout_constraintTop_toBottomOf="@+id/Card_view">

        <EditText
            android:id="@+id/Box2_name"
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/gradient_box"
            android:hint="@string/hint_your_name"
            android:inputType="textPersonName"
            android:paddingStart="45dp"
            android:textColorHint="#A4A4A4"
            android:textSize="@dimen/text_size_box" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="17dp"
            android:src="@drawable/ic_user" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/Title_Password_Register"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="75dp"
        android:layout_marginEnd="220dp"
        android:text="@string/text_title_password"
        android:textColor="#A4A4A4"
        android:textSize="@dimen/text_size_box"
        app:layout_constraintEnd_toEndOf="@id/Card_view2"
        app:layout_constraintStart_toStartOf="@id/Card_view2"
        app:layout_constraintTop_toBottomOf="@id/Title_Name" />

    <androidx.cardview.widget.CardView
        android:id="@+id/Card_view2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        app:cardCornerRadius="12dp"
        app:cardUseCompatPadding="false"
        app:layout_constraintEnd_toEndOf="@+id/Card_view1"
        app:layout_constraintStart_toStartOf="@id/Card_view1"
        app:layout_constraintTop_toBottomOf="@+id/Card_view1">

        <EditText
            android:id="@+id/Box3_pass"
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/gradient_box"
            android:hint="@string/hint_pass"
            android:inputType="textPassword"
            android:paddingStart="45dp"
            android:textColorHint="#A4A4A4"
            android:textSize="@dimen/text_size_box" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="17dp"
            android:src="@drawable/pass" />

    </androidx.cardview.widget.CardView>

    <FrameLayout
        android:id="@+id/Card_view3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/gradient_button"
        app:layout_constraintEnd_toEndOf="@+id/Card_view2"
        app:layout_constraintStart_toStartOf="@id/Card_view2"
        app:layout_constraintTop_toBottomOf="@+id/Card_view2">
        <com.google.android.material.button.MaterialButton
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:text="@string/text_sign_up"
            android:textColor="#FFFFFF"
            android:textSize="17.92sp"
            android:textStyle="bold"
            android:backgroundTint="@android:color/transparent"/>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/Sign_up"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="@id/Card_view3"
        app:layout_constraintStart_toStartOf="@id/Card_view3"
        app:layout_constraintTop_toBottomOf="@id/Card_view3">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="60dp"
            android:layout_weight="1"
            android:background="#A4A4A4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:text="@string/sign_up_with"
            android:textColor="#A4A4A4"
            android:textSize="11.25sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginEnd="60dp"
            android:layout_weight="1"
            android:background="#A4A4A4" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/icon_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/Card_view3"
        app:layout_constraintStart_toStartOf="@id/Card_view3"
        app:layout_constraintTop_toBottomOf="@id/Card_view3">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/list_google"
            android:layout_width="58.1dp"
            android:layout_height="44dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="12dp"
            app:cardUseCompatPadding="false">

            <ImageView
                android:id="@+id/icon_google"
                android:layout_width="16.34dp"
                android:layout_height="19.39dp"
                android:layout_gravity="center"
                android:layout_marginTop="1dp"
                android:src="@drawable/google" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/list_apple"
            android:layout_width="58.1dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="12dp"
            app:cardUseCompatPadding="false">

            <ImageView
                android:id="@+id/icon_apple"
                android:layout_width="16.34dp"
                android:layout_height="19.39dp"
                android:layout_gravity="center"
                android:layout_marginTop="1dp"
                android:src="@drawable/img" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/list_facebook"
            android:layout_width="58.1dp"
            android:layout_height="44dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="12dp"
            app:cardUseCompatPadding="false">

            <ImageView
                android:id="@+id/icon_facebook"
                android:layout_width="16.34dp"
                android:layout_height="19.39dp"
                android:layout_gravity="center"
                android:layout_marginTop="1dp"
                android:src="@drawable/facebook" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>