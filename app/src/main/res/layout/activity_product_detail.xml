<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".detail.ProductDetailActivity">

    <ImageView
        android:id="@+id/imgProduct"
        android:layout_width="@dimen/dp_350dp"
        android:layout_height="@dimen/dp_240dp"
        android:scaleType="centerCrop"
        tools:src="@drawable/nike"
        app:layout_constraintTop_toBottomOf="@+id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/dp_40dp"
            android:layout_height="@dimen/dp_40dp"
            android:layout_margin="@dimen/dp_25dp"
            android:background="@android:color/transparent"
            android:src="@drawable/outline_chevron_backward_24"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>


    <ImageButton
            android:id="@+id/btnFavorite"
            android:layout_width="@dimen/dp_40dp"
            android:layout_height="@dimen/dp_40dp"
            android:layout_margin="@dimen/dp_25dp"
            android:background="@android:color/transparent"
            android:src="@drawable/heart_favorite_24"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerGallery"
        android:layout_width="@dimen/dp_0dp"
        android:layout_height="@dimen/dp_80dp"
        android:paddingStart="@dimen/dp_8dp"
        android:paddingEnd="@dimen/dp_8dp"
            android:layout_marginTop="@dimen/dp_35dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/imgProduct"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <LinearLayout
            android:id="@+id/layoutContent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0dp"
            android:orientation="vertical"
            android:padding="@dimen/dp_16dp"
            app:layout_constraintTop_toBottomOf="@id/recyclerGallery"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/btnAddToCart">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="@dimen/dp_10dp">

            <TextView
                    android:id="@+id/txtName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    android:textSize="@dimen/sp_20sp"
                    android:textColor="@android:color/black" />

            <ImageButton
                    android:id="@+id/btnMinus"
                    android:layout_width="@dimen/dp_36dp"
                    android:layout_height="@dimen/dp_36dp"
                    android:background="@drawable/bg_circle_button"
                    android:src="@drawable/outline_arrow_left_24"
                    android:scaleType="centerInside" />

            <TextView
                    android:id="@+id/txtPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_12dp"
                    android:textStyle="bold"
                    android:textSize="@dimen/sp_18sp"
                    android:textColor="@android:color/black" />

            <ImageButton
                    android:id="@+id/btnPlus"
                    android:layout_width="@dimen/dp_36dp"
                    android:layout_height="@dimen/dp_36dp"
                    android:background="@drawable/bg_circle_button"
                    android:src="@drawable/outline_arrow_right_24"
                    android:scaleType="centerInside" />
        </LinearLayout>


        <TextView
                android:id="@+id/txtShortDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp_14sp"
                android:textColor="@android:color/black"
                android:ellipsize="end"
                android:maxLines="2"
                android:paddingBottom="@dimen/dp_4dp"/>

        <View
                android:id="@+id/viewDividerShortDesc"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1dp"
                android:background="@android:color/darker_gray"
                android:layout_marginBottom="@dimen/dp_4dp"/>

        <TextView
                android:id="@+id/txtLongDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp_14sp"
                android:textColor="@android:color/black"
                android:maxLines="3"
                android:ellipsize="end"
                android:scrollHorizontally="false"
                android:lineSpacingExtra="@dimen/dp_4dp"
                android:paddingBottom="@dimen/dp_4dp"/>



        <TextView
                android:id="@+id/txtReadMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_readmore"
                android:textSize="@dimen/sp_14sp"
                android:textColor="@android:color/holo_blue_dark"
                android:paddingBottom="@dimen/dp_8dp"/>

        <View
                android:id="@+id/viewDividerAfterLongDesc"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1dp"
                android:background="@android:color/darker_gray"
                android:layout_marginBottom="@dimen/dp_8dp"/>



        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/dp_4dp">

            <TextView
                    android:id="@+id/tv_size"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tv_size"
                    android:textStyle="bold"
                    android:textSize="@dimen/sp_16sp"
                    android:ellipsize="none"
                    android:singleLine="true"/>

            <TextView
                    android:id="@+id/tv_ukus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tv_ukus"
                    android:textSize="@dimen/sp_16sp"
                    android:singleLine="true"/>
        </LinearLayout>



        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerSizes"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_60dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:overScrollMode="never"/>

    </LinearLayout>


    <Button
        android:id="@+id/btnAddToCart"
        android:layout_width="@dimen/dp_350dp"
        android:layout_height="@dimen/dp_60dp"
        android:text="@string/btn_addtocart"
        android:textStyle="bold"
        android:backgroundTint="@android:color/black"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="@dimen/dp_40dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
