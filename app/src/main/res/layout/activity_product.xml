<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4"
    tools:context=".ui.product.ProductShowActivity">

    <ImageView
        android:id="@+id/ic_nav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium"
        android:src="@drawable/ic_menu"
        app:layout_constraintBottom_toBottomOf="@+id/cv_search"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/cv_search" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_search"
        android:layout_width="@dimen/search_width"
        android:layout_height="@dimen/search_height"
        android:layout_margin="@dimen/margin_medium"
        app:cardCornerRadius="@dimen/radius"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:backgroundTint="@android:color/transparent"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="@dimen/padding_small"
            android:hint="Search product"
            android:padding="@dimen/padding_small" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_key_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        android:text="@string/product_search"
        android:textSize="@dimen/text_large"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/ic_nav"
        app:layout_constraintTop_toBottomOf="@+id/cv_search" />

    <TextView
        android:id="@+id/tv_product_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium"
        android:text="@string/product_count"
        android:textSize="@dimen/text_mediumlarge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_key_search" />

    <ImageView
        android:id="@+id/ic_sort"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_small"
        android:src="@drawable/ic_sort"
        app:layout_constraintBottom_toBottomOf="@+id/tv_key_search"
        app:layout_constraintEnd_toStartOf="@+id/ic_filter"
        app:layout_constraintTop_toTopOf="@+id/tv_key_search" />

    <ImageView
        android:id="@+id/ic_filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_filter"
        app:layout_constraintBottom_toBottomOf="@+id/tv_key_search"
        app:layout_constraintEnd_toEndOf="@id/cv_search"
        app:layout_constraintTop_toTopOf="@+id/tv_key_search" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_zero"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_product_count" />


</androidx.constraintlayout.widget.ConstraintLayout>