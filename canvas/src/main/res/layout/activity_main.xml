<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnUndo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_undo"
            android:alpha="0.5"
            android:clickable="false"/>

        <ImageButton
            android:id="@+id/btnRedo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_redo"
            android:alpha="0.5"
            android:clickable="false"/>

        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more"/>

        <ImageButton
            android:id="@+id/btnSave"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_download"
            android:scaleType="fitCenter"
            android:padding="8dp"/>
    </LinearLayout>

    <com.example.canvas.views.DrawView
        android:id="@+id/drawView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/adjustPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <LinearLayout
        android:id="@+id/adjustPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="15dp"
        android:background="#F9F9F9"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="Stroke"
                android:textColor="#3A3A3C"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"/>
            <SeekBar
                android:id="@+id/seekStroke"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progressDrawable="@drawable/custom_seekbar_track"
                android:thumb="@drawable/custom_seekbar_thumb"
                android:splitTrack="false"
                android:maxHeight="6dp"/>
            <TextView
                android:id="@+id/txtStrokeValue"
                android:layout_width="35dp"
                android:layout_height="wrap_content"
                android:text="10"
                android:gravity="end"
                android:textColor="#8E8E93"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="Opacity"
                android:textColor="#3A3A3C"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"/>
            <SeekBar
                android:id="@+id/seekAlpha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="255"
                android:progressDrawable="@drawable/custom_seekbar_track"
                android:thumb="@drawable/custom_seekbar_thumb"
                android:splitTrack="false"
                android:maxHeight="6dp"/>
            <TextView
                android:id="@+id/txtAlphaValue"
                android:layout_width="35dp"
                android:layout_height="wrap_content"
                android:text="100%"
                android:gravity="end"
                android:textColor="#8E8E93"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#F2F2F7"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/toolPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTools"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>

            <View
                android:id="@+id/btnColor1"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_circle_color"
                android:elevation="2dp"/>

            <View
                android:id="@+id/btnColor2"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_square_color"
                android:elevation="2dp"/>

            <ImageButton
                android:id="@+id/btnAdd"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_add"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/adjustImagePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnCancelAdjust"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="#FF3B30"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">

                <SeekBar
                    android:id="@+id/seekBrightness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="510"
                    android:progress="255"
                    android:progressDrawable="@drawable/custom_seekbar_track"
                    android:thumb="@drawable/custom_seekbar_thumb"
                    android:splitTrack="false"
                    android:maxHeight="4dp"/>

                <SeekBar
                    android:id="@+id/seekImageAlpha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="255"
                    android:progress="255"
                    android:progressDrawable="@drawable/custom_seekbar_track"
                    android:thumb="@drawable/custom_seekbar_thumb"
                    android:splitTrack="false"
                    android:maxHeight="4dp"/>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnConfirmAdjust"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_check"
                app:tint="#34C759"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>